# Docker Compose configuration. Copy to .env in the repository root.
# Replace the placeholders before using the application.
# Use an alphanumeric/hex DB password because it is inserted into DATABASE_URL.
DB_PASSWORD=replace-with-a-local-database-password
OPENAI_API_KEY=replace-with-your-openai-api-key
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Optional Stripe configuration, required only for payment features.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_100_CREDITS=

# Local URLs; defaults are also defined in docker-compose.yml.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
