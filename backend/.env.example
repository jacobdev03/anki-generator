# Local Python backend configuration. Copy to backend/.env.
# Docker Compose builds DATABASE_URL from DB_PASSWORD in the root .env instead.
DATABASE_URL=postgresql+psycopg2://postgres:replace-with-your-database-password@localhost:5432/anki-generator
OPENAI_API_KEY=replace-with-your-openai-api-key
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:3000

# Optional Stripe configuration, required only for payment features.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_100_CREDITS=
